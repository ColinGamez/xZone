{
  "name": "xzone",
  "version": "1.0.0",
  "description": "Xzone - Custom Xbox 360 ecosystem backend for Proto users",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node scripts/check-js.js",
    "test": "node --test",
    "validate": "npm run check && npm test && npm audit --omit=dev",
    "xbox:status": "node scripts/neighborhood.js status",
    "xbox:dir": "node scripts/neighborhood.js dir",
    "xbox:capture": "node scripts/neighborhood.js capture",
    "xbox:proxy-plan": "node scripts/neighborhood.js proxy-plan"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "sql.js": "^1.12.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
