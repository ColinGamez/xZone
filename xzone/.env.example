PORT=3000
HOST=0.0.0.0
DB_PATH=./db/xzone.db
REQUEST_BODY_LIMIT=128kb
XZONE_CORS_ORIGIN=*

# Optional: require X-Admin-Token for admin endpoints.
XZONE_ADMIN_TOKEN=

# Request discovery/logging.
XZONE_REQUEST_LOG=true
XZONE_LOG_DIR=./logs
XZONE_LOG_MAX_BODY_CHARS=4000
XZONE_OPS_ALLOW_LOCALHOST=true
XZONE_OPS_MAX_RECENT_REQUESTS=200

# Presence and Famestar tuning.
XZONE_ONLINE_WINDOW_SECONDS=300
XZONE_HEARTBEAT_POINT_COOLDOWN_SECONDS=300

# Set true only when running behind a trusted reverse proxy.
XZONE_TRUST_PROXY=false
